; PCL3 配置文件模板
; 复制本文件为 PCL3.config.ini，与 PCL 本体放在同一目录。
; 键名不区分大小写，支持 [节名] 分节；也可以直接写 节名.键名 的形式。
; 优先级：环境变量 PCL3_XXX > 本文件 > 程序默认值。
; 例：想临时覆盖 CurseForge 密钥，可设环境变量 PCL3_AUTH_CURSEFORGEAPIKEY。

[Download]

; 是否解锁原版 Minecraft 下载。
;   true  = 恢复下载页与原版安装（本工程的目的）
;   false = 与上游开源版一致，下载页隐藏、安装时抛异常
; 说明：本程序不托管任何游戏文件，下载请求指向 Mojang 官方服务器与 BMCLAPI 等公开镜像。
; 请确认你已合法持有 Minecraft: Java Edition。
UnlockVanilla = true

[Auth]

; ============================================================
; 微软正版登录用的 Azure 应用 ClientId
; ============================================================
; PCL 用的是「设备码登录」（Device Code Flow），只需要一个 client_id，
; 不需要密钥、不需要回调地址。所以你自己注册一个免费应用就行。
;
; 注册步骤（约 3 分钟）：
;   1. 打开 https://portal.azure.com  用微软账号登录
;   2. 搜索并进入「Microsoft Entra ID」→ 左侧「应用注册」→「新注册」
;   3. 名称随便填（比如 PCL3）；「受支持的账户类型」选
;      「仅个人 Microsoft 账户」（PCL 用的是 /consumers 端点，必须选这个）
;   4. 注册完，在「概述」页复制「应用程序(客户端) ID」，形如
;      12345678-1234-1234-1234-123456789abc
;   5. 左侧「身份验证」→ 拉到底「允许公共客户端流」→ 选「是」→ 保存
;      （不勾这个，设备码登录会被拒）
;   6. 把那个 ID 填到下面 MsClientId = 后面
;
; 填完保存，重启 PCL，启动页选「正版」就能登录了。
; 留空则正版登录不可用，只能用离线登录。
MsClientId =

; ============================================================
; CurseForge API Key
; ============================================================
; 留空则 CurseForge 源不可用，但 Modrinth 源仍然正常工作（Modrinth 不校验密钥）。
; 获取方式：https://console.curseforge.com/
CurseForgeApiKey =

; ============================================================
; 联机
; ============================================================
; 联机不使用 PCL 内置的 EasyTier（上游的会合节点已停服），
; 改用独立隧道工具：双击 tools\bore\start-tunnel.bat，输入游戏端口即可。
; 这里不需要配置任何东西。

[Launch]

; ============================================================
; 启动方式
; ============================================================
; true  = 用「正版」登录时，点「开始游戏」会唤起 Minecraft 官方启动器，
;         由它完成正版登录和启动；PCL 负责下载、模组、联机。
;         注意：只在正版登录下生效，离线 / 第三方登录仍然由 PCL 自己启动
;         （官方启动器不认这些账号，送去那边反而玩不了）。
; false = 一律由 PCL 自己启动。
;
; 找不到官方启动器时会自动回退到 PCL 自己启动，所以填 true 也不会导致完全打不开。
UseOfficialLauncher = true
